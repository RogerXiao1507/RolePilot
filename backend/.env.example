OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/applyiq
AUTH_ISSUER=https://your-tenant.us.auth0.com/
AUTH_AUDIENCE=https://api.rolepilot.example
# Optional; defaults to AUTH_ISSUER + .well-known/jwks.json
# AUTH_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
# Private S3-compatible object storage for original resume PDFs
OBJECT_STORAGE_BUCKET=rolepilot-private
# Set for Cloudflare R2, Backblaze B2, MinIO, or another S3-compatible provider
# OBJECT_STORAGE_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=your_private_storage_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_private_storage_secret
OBJECT_STORAGE_SIGNED_URL_SECONDS=300
OBJECT_STORAGE_SSE_ALGORITHM=AES256
# Set true in production so the API refuses to start without private resume storage.
OBJECT_STORAGE_REQUIRED=false
MAX_RESUME_UPLOAD_BYTES=10485760
MAX_RESUME_PAGES=10
MAX_RESUME_TEXT_CHARS=100000
JOB_URL_TIMEOUT_SECONDS=15
JOB_URL_MAX_REDIRECTS=3
JOB_URL_MAX_RESPONSE_BYTES=2097152
# Public Greenhouse ingestion is disabled by default as a connector kill switch.
JOB_DISCOVERY_GREENHOUSE_ENABLED=false
# JSON list of public employer board tokens, e.g. ["example-company"]
JOB_DISCOVERY_GREENHOUSE_BOARDS=[]
JOB_DISCOVERY_LEVER_ENABLED=false
# region accepts "global" or "eu".
JOB_DISCOVERY_LEVER_BOARDS=[]
# Example: [{"site":"example","company_name":"Example Inc.","region":"global"}]
JOB_DISCOVERY_ASHBY_ENABLED=false
# Example: [{"identifier":"Example","company_name":"Example Inc."}]
JOB_DISCOVERY_ASHBY_BOARDS=[]
JOB_DISCOVERY_SMARTRECRUITERS_ENABLED=false
# Example: [{"identifier":"example","company_name":"Example Inc."}]
JOB_DISCOVERY_SMARTRECRUITERS_BOARDS=[]
JOB_DISCOVERY_PERSONIO_ENABLED=false
# job_url_template may contain {id}; defaults to the hosted Personio job URL.
# Example: [{"account":"example","company_name":"Example GmbH","domain":"com"}]
JOB_DISCOVERY_PERSONIO_BOARDS=[]
JOB_DISCOVERY_MAX_RESPONSE_BYTES=8388608
JOB_DISCOVERY_MAX_JOBS_PER_BOARD=500
