OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/applyiq
AUTH_ISSUER=https://your-tenant.us.auth0.com/
AUTH_AUDIENCE=https://api.rolepilot.example
# Optional; defaults to AUTH_ISSUER + .well-known/jwks.json
# AUTH_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
MAX_RESUME_UPLOAD_BYTES=10485760
MAX_RESUME_PAGES=10
MAX_RESUME_TEXT_CHARS=100000
JOB_URL_TIMEOUT_SECONDS=15
JOB_URL_MAX_REDIRECTS=3
JOB_URL_MAX_RESPONSE_BYTES=2097152
